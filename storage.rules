rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && firestore.exists(userPath());
    }

    function userData() {
      return firestore.get(userPath()).data;
    }

    // Super-admin check uses Firebase custom claims (set server-side only via Admin SDK).
    // Never hardcode emails here — they cannot be rotated without a rules redeploy.
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('superAdmin', false) == true ||
        (hasUserDoc() && userData().isSuperAdmin == true && userData().role == 'admin')
      );
    }

    function canAccessHome(homeId) {
      return isSuperAdmin() ||
        (isSignedIn() && homeId == request.auth.uid) ||
        (hasUserDoc() && (userData().homeId == homeId || userData().activeHomeId == homeId));
    }

    match /intakes/{homeId}/{residentId}/{allPaths=**} {
      allow read, write: if canAccessHome(homeId);
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read, write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
